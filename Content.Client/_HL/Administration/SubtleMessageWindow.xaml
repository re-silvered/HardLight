<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="Subtle Message"
    SetSize="560 640"
    MinSize="500 560">
    <BoxContainer Orientation="Vertical" SeparationOverride="6">
        <Label Text="World text" />
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#17191d" BorderColor="#59616b" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <TextEdit Name="PopupMessage" Access="Public" MinHeight="54" Margin="4" />
        </PanelContainer>

        <BoxContainer Orientation="Horizontal">
            <CheckBox Name="SendChat" Access="Public" Text="Send chat copy" />
            <LineEdit Name="ChatMessage" Access="Public" PlaceHolder="Chat copy, blank uses world text" HorizontalExpand="True" />
        </BoxContainer>

        <GridContainer Columns="3">
            <CheckBox Name="KeepOpen" Access="Public" Text="Keep open" Pressed="True" />
            <CheckBox Name="Preview" Access="Public" Text="Preview for self" />
            <CheckBox Name="DisplayToAll" Access="Public" Text="Show to all" />
            <CheckBox Name="UseCoordinates" Access="Public" Text="Use coordinates" Pressed="True" />
            <CheckBox Name="AnchorToRecipients" Access="Public" Text="Anchor to recipients" />
            <CheckBox Name="UseRecipientOffset" Access="Public" Text="Use X/Y as offset" />
        </GridContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Label Name="XCoordLabel" Access="Public" Text="X" />
            <LineEdit Name="XCoord" Access="Public" MinWidth="64" MaxWidth="80" />
            <Label Name="YCoordLabel" Access="Public" Text="Y" />
            <LineEdit Name="YCoord" Access="Public" MinWidth="64" MaxWidth="80" />
            <Button Name="UseCurrentPosition" Access="Public" Text="My position" />
        </BoxContainer>

        <Label Text="Players" />
        <LineEdit Name="PlayerSearch" Access="Public" PlaceHolder="Search players..." />
        <ItemList Name="Players" Access="Public" MinHeight="150" VerticalExpand="True" />

        <GridContainer Columns="2">
            <Label Text="Presets" />
            <BoxContainer Name="Presets" Access="Public" Orientation="Horizontal" SeparationOverride="4" />
            <Label Text="Color" />
            <LineEdit Name="ColorHex" Access="Public" Text="#ff3333" HorizontalExpand="True" />
            <Label Text="Recent" />
            <BoxContainer Name="Swatches" Access="Public" Orientation="Horizontal" SeparationOverride="4" />
            <Label Text="Preview" />
            <Label Name="ColorPreview" Access="Public" Text="Cryptic text" />
        </GridContainer>

        <GridContainer Columns="2">
            <CheckBox Name="Rainbow" Access="Public" Text="Scrolling rainbow" />
            <CheckBox Name="Wiggle" Access="Public" Text="Wiggle" Pressed="True" />
            <Label Name="WaveSpeedLabel" Access="Public" Text="Wave speed" />
            <LineEdit Name="WaveSpeed" Access="Public" Text="3" />
            <Label Name="WaveHeightLabel" Access="Public" Text="Wave height" />
            <LineEdit Name="WaveHeight" Access="Public" Text="3" />
            <Label Text="Text display speed" />
            <LineEdit Name="RevealSpeed" Access="Public" Text="5" />
            <Label Text="Linger time" />
            <LineEdit Name="LingerTime" Access="Public" Text="4" />
            <Label Text="Scale" />
            <LineEdit Name="Scale" Access="Public" Text="1" />
        </GridContainer>

        <Button Name="ExecuteButton" Access="Public" Text="Execute" HorizontalAlignment="Center" />
    </BoxContainer>
</DefaultWindow>
